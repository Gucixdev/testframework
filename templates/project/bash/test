#!/usr/bin/env bash
# test - run the project's tests: bats if installed, else every tests/*.sh as a plain script. 0 arguments.
# Template: copy to the project root as `test` (no extension). A plain test is an executable tests/NAME.sh that
# exits 0 on success; it gets a private temp HOME (TEST_HOME) and a PATH with tests/fakes first for fake binaries.
# Lint first when shellcheck is there. Exit code: 0 all passed, 1 something failed.
set -u
case ${1:-} in -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;; esac
cd "$(dirname "$(readlink -f "$0")")" || exit 1

fail=0
if command -v shellcheck > /dev/null 2>&1; then
	# EDIT: the files that must stay clean
	shellcheck -S warning run build setup wizard 2> /dev/null || { echo "test: shellcheck found problems" >&2; fail=1; }
else
	echo "test: shellcheck not installed, lint skipped" >&2
fi

if command -v bats > /dev/null 2>&1 && ls tests/*.bats > /dev/null 2>&1; then
	bats tests/ || fail=1
else
	tmp=$(mktemp -d) || exit 1
	trap 'rm -rf "$tmp"' EXIT
	n=0
	for t in tests/*.sh; do
		[ -f "$t" ] || continue
		n=$((n + 1))
		if HOME="$tmp" TEST_HOME="$tmp" PATH="$PWD/tests/fakes:$PATH" bash "$t" > "$tmp/out" 2>&1; then
			echo "ok   $t"
		else
			echo "FAIL $t"; sed 's/^/     /' "$tmp/out"; fail=1
		fi
	done
	[ "$n" -gt 0 ] || echo "test: no tests found (tests/*.bats or tests/*.sh)" >&2
fi
exit "$fail"
